{
  "name": "the-pressure-index",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "npm run check:content && npm run check:copy && next build && node scripts/check-publication.mjs --built && npm run check:built",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:content": "node scripts/check-content.mjs",
    "test": "node --experimental-strip-types scripts/run-content-tests.mjs",
    "test:browser": "playwright test",
    "report:pdf": "node --experimental-strip-types scripts/render-report.mjs",
    "format": "prettier --write app components lib tests scripts content/*.ts *.ts *.mjs *.md",
    "format:check": "prettier --check app components lib tests scripts content/*.ts *.ts *.mjs *.md",
    "check:copy": "node --experimental-strip-types scripts/check-copy.mjs",
    "check:built": "node --experimental-strip-types scripts/check-built-content.mjs",
    "report:withdraw": "node scripts/report-state.mjs --withdraw",
    "verify:deployment": "node --experimental-strip-types scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "lucide-react": "1.74.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "ignore": "5.3.2",
    "lighthouse": "13.6.0",
    "parse5": "8.0.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  },
  "type": "module"
}
